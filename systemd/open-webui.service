[Unit]
Description=Open WebUI (chat and image front end for ai-box)
Documentation=https://docs.openwebui.com/
After=network-online.target
Wants=network-online.target
# Deliberately no Wants=/Requires= on llama-server: this unit starts fine while the
# model is still loading, and llama-server and llama-router conflict with each other.

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__AI_HOME__/openwebui
Environment=HOME=__HOME__
EnvironmentFile=-__CONFIG_DIR__/openwebui.env
# HOST/PORT come from openwebui.env: 127.0.0.1 until scripts/81-front-door.sh has
# a default-deny firewall covering :3000, then 0.0.0.0 for the Caddy VM.
ExecStart=__AI_HOME__/openwebui/venv/bin/open-webui serve --host ${HOST} --port ${PORT}
Restart=on-failure
RestartSec=10
# First start creates the SQLite schema; it is quick, but not instant.
TimeoutStartSec=300
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

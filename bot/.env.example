# ai-box Discord bot configuration.
# Copied to <repo>/.env by scripts/40-install-bot.sh.
#
# This file is read by BOTH python-dotenv and systemd's EnvironmentFile, so:
#   - no `export`, no inline comments after a value
#   - quote values that contain spaces
#   - keep every value on one line

# --- Discord -----------------------------------------------------------------
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
# Right-click your server -> Copy Server ID (needs Developer Mode in Discord).
# Set it for instant slash-command sync; leave empty for global commands.
DISCORD_GUILD_ID=
# Optional: only members with this role may use the bot. Empty = everyone.
ALLOWED_ROLE_ID=
# Reply when the bot is @mentioned in a channel (needs the message_content intent).
REPLY_ON_MENTION=false

# --- Local LLM (llama-server) ------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:8080
LLM_API_KEY=local
# Must match llama-server's --alias (or the model id it reports at /v1/models).
LLM_MODEL=local
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
# Reasoning models: false keeps chain-of-thought out of the Discord message.
LLM_ENABLE_THINKING=false
# Should match llama-server --parallel.
LLM_MAX_CONCURRENT=2
HISTORY_TURNS=12
SYSTEM_PROMPT="You are a helpful, concise assistant in a Discord chat. Prefer short paragraphs and fenced code blocks with a language tag. Never claim to have run code you did not run."

# --- ComfyUI -----------------------------------------------------------------
COMFY_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=bot/workflows/sdxl.api.json
# Substituted into the graph at request time; must exist in ComfyUI/models/checkpoints.
COMFY_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFY_DEFAULT_STEPS=28
COMFY_TIMEOUT_S=900

# --- Behaviour ---------------------------------------------------------------
# Seconds between live message edits. Do not go below ~1.0 (Discord rate limits).
STREAM_EDIT_INTERVAL=1.2
DB_PATH=~/ai/data/bot.sqlite3
LOG_LEVEL=INFO

{
  "mcpServers": {
    "filesystem": {
      "command": "/usr/bin/npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/ai-user/ai-box"
      ]
    },
    "git": {
      "command": "/usr/bin/uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "/home/ai-user/ai-box"
      ]
    }
  }
}
